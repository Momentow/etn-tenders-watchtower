      ],
      "title": "Request",
      "type": "object"
    },
    "StatusRule": {
      "additionalProperties": false,
      "description": "How the portal marks a tender's status. `value` reads the label; `withdrawn` / `closed` are case-insensitive\nregexes on it. No match → `open` (the pipeline still closes tenders past their deadline or no longer listed).",
      "properties": {
        "value": {
          "$ref": "#/$defs/FieldRule"
        },
        "withdrawn": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Withdrawn",
          "type": "array"
        },
        "closed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Closed",
          "type": "array"
        }
      },
      "required": [
        "value"
      ],
      "title": "StatusRule",
      "type": "object"
    },
    "SubmitStep": {
      "additionalProperties": false,
      "description": "Submit a form on the current page: the engine keeps its hidden inputs (e.g. ASP.NET __VIEWSTATE), applies\n`values`, and sends it to the form's action with its method.",
      "properties": {
        "action": {
          "const": "submit",
          "title": "Action",
          "type": "string"
        },
        "form": {
          "title": "Form",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "action",
        "form"
      ],
      "title": "SubmitStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1,
      "default": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "country": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Country"
    },
    "software": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Software"
    },
    "list": {
      "discriminator": {
        "mapping": {
          "html": "#/$defs/HtmlList",
          "json": "#/$defs/JsonList"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/HtmlList"
        },
        {
          "$ref": "#/$defs/JsonList"
        }
      ],
      "title": "List"
    },
    "detail": {
      "anyOf": [
        {
          "$ref": "#/$defs/Detail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fields": {
      "$ref": "#/$defs/Fields"
    },
    "documents": {
      "anyOf": [
        {
          "$ref": "#/$defs/Documents"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatusRule"
